{
  "name": "ccbm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/rules.test.ts",
    "postinstall": "prisma generate",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test:integration": "CCBM_INTEGRATION=1 node --import tsx --test tests/integration.test.ts",
    "test:e2e": "playwright test",
    "db:seed:demo": "node --env-file-if-exists=.env --import tsx prisma/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.750.0",
    "@aws-sdk/s3-request-presigner": "3.750.0",
    "@hookform/resolvers": "^5",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-slot": "^1",
    "@tanstack/react-table": "^8",
    "bcryptjs": "^3",
    "clsx": "^2",
    "next": "15.5.18",
    "next-auth": "5.0.0-beta.30",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "recharts": "^2",
    "tailwind-merge": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "postcss": "^8",
    "prisma": "^6.19.0",
    "tailwindcss": "^3",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
